<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="amr_robot">

    <!-- Materials / Appearance for RViz -->
    <material name="wood"><color rgba="0.72 0.53 0.35 1.0"/></material>
    <material name="white_body"><color rgba="0.95 0.95 0.95 1.0"/></material>
    <material name="tire_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    <material name="caster_metal"><color rgba="0.6 0.6 0.6 1.0"/></material>
    <material name="lidar_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

    <!-- Inertial Helper Macro -->
    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
                     izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <!-- ==================== BASE FOOTPRINT & KINEMATIC ORIGIN ==================== -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </joint>

    <!-- ==================== LAYER 1: BOTTOM WOODEN PLATE ==================== -->
    <link name="base_link">
        <visual>
            <origin xyz="0.06 0 0.005" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.010"/>
            </geometry>
            <material name="wood"/>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.005" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.010"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.06 0 0.005" rpy="0 0 0"/>
            <mass value="0.55"/>
            <inertia ixx="0.0033" ixy="0" ixz="0" iyy="0.0033" iyz="0" izz="0.0066"/>
        </inertial>
    </link>

    <!-- ==================== LOWER WHITE SHROUD ==================== -->
    <link name="lower_shroud">
        <visual>
            <origin xyz="0.06 0 0.040" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.080"/>
            </geometry>
            <material name="white_body"/>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.040" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.080"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.06 0 0.040" rpy="0 0 0"/>
            <mass value="0.25"/>
            <inertia ixx="0.0016" ixy="0" ixz="0" iyy="0.0016" iyz="0" izz="0.0030"/>
        </inertial>
    </link>

    <joint name="lower_shroud_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lower_shroud"/>
        <origin xyz="0 0 0.010" rpy="0 0 0"/>
    </joint>

    <!-- ==================== LAYER 2: MIDDLE WOODEN PLATE ==================== -->
    <link name="mid_plate">
        <visual>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.009"/>
            </geometry>
            <material name="wood"/>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.009"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <mass value="0.50"/>
            <inertia ixx="0.0030" ixy="0" ixz="0" iyy="0.0030" iyz="0" izz="0.0060"/>
        </inertial>
    </link>

    <joint name="mid_plate_joint" type="fixed">
        <parent link="lower_shroud"/>
        <child link="mid_plate"/>
        <origin xyz="0 0 0.080" rpy="0 0 0"/>
    </joint>

    <!-- ==================== CENTRAL CYLINDER (TOWER COLUMN) ==================== -->
    <link name="central_cylinder">
        <visual>
            <origin xyz="0.06 0 0.077" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0845" length="0.154"/>
            </geometry>
            <material name="white_body"/>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.077" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0845" length="0.154"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.06 0 0.077" rpy="0 0 0"/>
            <mass value="0.45"/>
            <inertia ixx="0.0017" ixy="0" ixz="0" iyy="0.0017" iyz="0" izz="0.0016"/>
        </inertial>
    </link>

    <joint name="central_cylinder_joint" type="fixed">
        <parent link="mid_plate"/>
        <child link="central_cylinder"/>
        <origin xyz="0 0 0.009" rpy="0 0 0"/>
    </joint>

    <!-- ==================== LAYER 3: TOP WOODEN PLATE ==================== -->
    <link name="top_plate">
        <visual>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.009"/>
            </geometry>
            <material name="wood"/>
        </visual>
        <collision>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.155" length="0.009"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.06 0 0.0045" rpy="0 0 0"/>
            <mass value="0.50"/>
            <inertia ixx="0.0030" ixy="0" ixz="0" iyy="0.0030" iyz="0" izz="0.0060"/>
        </inertial>
    </link>

    <joint name="top_plate_joint" type="fixed">
        <parent link="central_cylinder"/>
        <child link="top_plate"/>
        <origin xyz="0 0 0.154" rpy="0 0 0"/>
    </joint>

    <!-- ==================== 2D LIDAR LINK & JOINT ==================== -->
    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.038" length="0.04"/>
            </geometry>
            <material name="lidar_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.038" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.15"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="top_plate"/>
        <child link="laser_frame"/>
        <!-- Centered on top plate (X=0.06), elevated by half lidar height (0.02 + plate thickness 0.009) -->
        <origin xyz="0.06 0 0.029" rpy="0 0 0"/>
    </joint>

    <!-- ==================== DRIVE WHEELS ==================== -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.039"/>
            </geometry>
            <material name="tire_black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04" length="0.039"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.25" r="0.04" h="0.039"/>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.0995 -0.02" rpy="-1.5708 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.04" length="0.039"/>
            </geometry>
            <material name="tire_black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.04" length="0.039"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.25" r="0.04" h="0.039"/>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.0995 -0.02" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ==================== TWO-LINK SWIVEL CASTER ==================== -->
    <link name="caster_swivel">
        <visual>
            <origin xyz="0 0 -0.015" rpy="0 0 0"/>
            <geometry>
                <box size="0.035 0.035 0.030"/>
            </geometry>
            <material name="caster_metal"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.015" rpy="0 0 0"/>
            <geometry>
                <box size="0.035 0.035 0.030"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.10"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <joint name="caster_swivel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="caster_swivel"/>
        <origin xyz="0.17 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.018"/>
            </geometry>
            <material name="tire_black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.018"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.06" r="0.02" h="0.018"/>
    </link>

    <joint name="caster_wheel_joint" type="continuous">
        <parent link="caster_swivel"/>
        <child link="caster_wheel"/>
        <origin xyz="-0.015 0 -0.04" rpy="-1.5708 0 0"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <!-- ==================== GAZEBO PHYSICS & MATERIAL PROPERTIES ==================== -->
    <gazebo reference="left_wheel">
        <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="10000000.0"/>
        <kd value="1.0"/>
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1 value="1.0"/>
        <mu2 value="1.0"/>
        <kp value="10000000.0"/>
        <kd value="1.0"/>
        <material>Gazebo/FlatBlack</material>
    </gazebo>

    <gazebo reference="caster_wheel">
        <mu1 value="0.01"/>
        <mu2 value="0.01"/>
        <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="caster_swivel"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="base_link"><material>Gazebo/Wood</material></gazebo>
    <gazebo reference="mid_plate"><material>Gazebo/Wood</material></gazebo>
    <gazebo reference="top_plate"><material>Gazebo/Wood</material></gazebo>
    <gazebo reference="lower_shroud"><material>Gazebo/White</material></gazebo>
    <gazebo reference="central_cylinder"><material>Gazebo/White</material></gazebo>
    <gazebo reference="laser_frame"><material>Gazebo/FlatBlack</material></gazebo>

    <!-- ==================== GAZEBO DIFFERENTIAL DRIVE PLUGIN ==================== -->
    <gazebo>
        <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <update_rate>50</update_rate>
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.199</wheel_separation>
            <wheel_diameter>0.080</wheel_diameter>
            <max_wheel_torque>20.0</max_wheel_torque>
            <max_wheel_acceleration>1.0</max_wheel_acceleration>
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>

    <!-- ==================== GAZEBO 2D LIDAR SENSOR PLUGIN ==================== -->
    <gazebo reference="laser_frame">
        <sensor name="laser_sensor" type="ray">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <!-- Minimum distance from sensor center (prevents detecting the robot's own plate edge) -->
                    <min>0.16</min>
                    <!-- Maximum distance in meters -->
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <!-- Remap internal gazebo ray topic to standard ROS /scan -->
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>
<!-- ==================== JOINT STATE PUBLISHER ==================== -->
    <gazebo>
        <plugin name="amr_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
           <ros>
           <remapping>~/out:=joint_states</remapping>
              </ros>
            <update_rate>30</update_rate>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
            <joint_name>caster_swivel_joint</joint_name>
            <joint_name>caster_wheel_joint</joint_name>
        </plugin>
    </gazebo>
   <!-- ==================== IMU SENSOR ==================== -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.005"/>
            </geometry>
            <material name="tire_black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.02 0.005"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- Centered exactly between the drive wheels (X=0, Y=0) -->
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
</joint>
<!-- ==================== GAZEBO IMU PLUGIN ==================== -->
<gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <remapping>~/out:=imu/data</remapping>
            </ros>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
    </sensor>
</gazebo>

 <!-- ==================== ULTRASONIC SENSOR MACRO ==================== -->
    <xacro:macro name="ultrasonic_sensor" params="prefix parent x y z roll pitch yaw topic_name">
        <link name="${prefix}_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="0.008" length="0.002"/>
                </geometry>
                <material name="tire_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 1.5708 0"/>
                <geometry>
                    <cylinder radius="0.008" length="0.002"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>

        <joint name="${prefix}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
        </joint>

        <gazebo reference="${prefix}_link">
            <sensor name="${prefix}_sensor" type="ray">
                <pose>0 0 0 0 0 0</pose>
                <visualize>true</visualize>
                <update_rate>20</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>5</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.13</min_angle>
                            <max_angle>0.13</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>5</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.13</min_angle>
                            <max_angle>0.13</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.02</min>
                        <max>2.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <plugin name="${prefix}_controller" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <remapping>~/out:=${topic_name}</remapping>
                    </ros>
                    <output_type>sensor_msgs/Range</output_type>
                    <radiation_type>ultrasound</radiation_type>
                    <frame_name>${prefix}_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- ==================== ULTRASONIC SENSOR INSTANCES ==================== -->
    <!-- Front Ultrasonic -->
    <xacro:ultrasonic_sensor 
        prefix="sonar_front" 
        parent="base_link" 
        x="0.215" y="0.0" z="0.04" 
        roll="0.0" pitch="0.0" yaw="0.0" 
        topic_name="sonar_front/range" />

    <!-- Left Ultrasonic -->
    <xacro:ultrasonic_sensor 
        prefix="sonar_left" 
        parent="base_link" 
        x="0.06" y="0.155" z="0.04" 
        roll="0.0" pitch="0.0" yaw="1.5708" 
        topic_name="sonar_left/range" />

    <!-- Right Ultrasonic -->
    <xacro:ultrasonic_sensor 
        prefix="sonar_right" 
        parent="base_link" 
        x="0.06" y="-0.155" z="0.04" 
        roll="0.0" pitch="0.0" yaw="-1.5708" 
        topic_name="sonar_right/range" />


</robot>